# Entrypoint
# -----------------------------
worker_service = WorkerService()

def _handle_signal(sig):
    logger.info("Received signal %s, initiating shutdown", sig)
    asyncio.create_task(worker_service.stop())

def main():
    # register signals
    loop = asyncio.get_event_loop()
    for s in (signal.SIGINT, signal.SIGTERM):
        try:
            loop.add_signal_handler(s, lambda s=s: _handle_signal(s))
        except NotImplementedError:
            # Windows or restricted envs
            signal.signal(s, lambda sig, frame: _handle_signal(sig))

    # run startup and consumer loop
    async def _run():
        await worker_service.start()
        # run consumer loop until shutdown
        await worker_service.consumer_loop()

    try:
        loop.run_until_complete(_run())
    except Exception:
        logger.exception("Worker main failed")
    finally:
        logger.info("Worker exiting")

if __name__ == "__main__":
    main()