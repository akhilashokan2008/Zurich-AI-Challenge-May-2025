# -----------------------------
# Circuit Breaker for LLM (simple Redis-backed)
# -----------------------------
class LLMCircuitBreaker:
    def __init__(self, redis: Redis, threshold: int, cooldown: int):
        self.redis = redis
        self.failures_key = "llm:circuit:failures"
        self.state_key = "llm:circuit:state"
        self.threshold = threshold
        self.cooldown = cooldown

    async def allowed(self) -> bool:
        try:
            state = await self.redis.get(self.state_key)
            if state == "open":
                return False
        except Exception:
            # If redis unavailable, conservatively allow and rely on retry/backoff
            return True
        return True

    async def record_failure(self):
        try:
            fails = await self.redis.incr(self.failures_key)
            await self.redis.expire(self.failures_key, self.cooldown * 2)
            if int(fails) >= self.threshold:
                await self.redis.set(self.state_key, "open", ex=self.cooldown)
                logger.warning("LLM circuit opened due to %d failures", fails)
        except Exception:
            logger.debug("Could not update LLM circuit state in Redis")

    async def record_success(self):
        try:
            await self.redis.delete(self.failures_key)
            await self.redis.delete(self.state_key)
        except Exception:
            pass

# -----------------------------
# Helper utilities
# -----------------------------
def pii_safe(val: Optional[str]) -> str:
    if not val:
        return ""
    s = str(val)
    if len(s) <= 6:
        return "****"
    return s[:2] + "****" + s[-2:]

def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()

def make_consumer_name() -> str:
    # include short uuid to avoid PID collisions across restarts
    return f"{settings.IDENTITY_PREFIX}_{uuid.uuid4().hex[:8]}"

# -----------------------------
# Worker service
# -----------------------------
class WorkerService:
    def __init__(self):
        self.consumer_name = make_consumer_name()
        self.shutdown_event = asyncio.Event()
        self._task_group: Optional[asyncio.TaskGroup] = None
        self._concurrency = settings.CONCURRENCY_BASE
        self._semaphore = asyncio.Semaphore(self._concurrency)
        self._latency_history: List[float] = []
        self._llm_circuit: Optional[LLMCircuitBreaker] = None

    async def start(self):
        global REDIS_POOL, redis_client, llm_client
        # initialize redis pool/client
        REDIS_POOL = ConnectionPool.from_url(settings.REDIS_URL, max_connections=settings.REDIS_POOL_MAX)
        redis_client = redis.Redis(connection_pool=REDIS_POOL, decode_responses=True)
        # Test connection
        try:
            await redis_client.ping()
            logger.info("Connected to Redis at %s", settings.REDIS_URL)
        except Exception as e:
            logger.exception("Cannot connect to Redis: %s", e)
            raise

        # Ensure consumer group exists
        try:
            await redis_client.xgroup_create(settings.REDIS_STREAM_INPUT, settings.REDIS_CONSUMER_GROUP, id="0", mkstream=True)
            logger.info("Consumer group created: %s/%s", settings.REDIS_STREAM_INPUT, settings.REDIS_CONSUMER_GROUP)
        except redis.exceptions.ResponseError as e:
            if "BUSYGROUP" in str(e):
                logger.debug("Consumer group already exists")
            else:
                logger.exception("xgroup_create error: %s", e)
                raise

        # create llm client
        llm_client = httpx.AsyncClient(base_url=settings.LLM_API_BASE_URL, timeout=settings.LLM_TIMEOUT)
        self._llm_circuit = LLMCircuitBreaker(redis_client, settings.LLM_CIRCUIT_THRESHOLD, settings.LLM_CIRCUIT_COOLDOWN)

        # start metrics server
        asyncio.create_task(asyncio.to_thread(_start_metrics))

        # start main consumer loop
        asyncio.create_task(self.consumer_loop())

    async def stop(self):
        self.shutdown_event.set()
        # closing httpx & redis gracefully
        try:
            if llm_client:
                await llm_client.aclose()
        except Exception:
            pass
        try:
            if redis_client:
                await redis_client.close()
        except Exception:
            pass
        logger.info("WorkerService stopped")

    async def _process_entry(self, msg_id: str, data: Dict[str, Any]) -> bool:
        """Process a single stream message. Returns True on success (ack now), False otherwise."""
        start = time.time()
        MET_MESSAGES_RECEIVED.inc()

        # Wrap in trace span if opentelemetry is configured
        tracer = trace.get_tracer(__name__)
        with tracer.start_as_current_span("process_message", attributes={"redis.message_id": msg_id}):
            try:
                # Validate expected payload form
                payload_raw = data.get("payload") or data.get("data") or data.get("message")
                if not payload_raw:
                    raise ValueError("Missing payload field")

                # payload_raw may be JSON string or map depending on producer
                if isinstance(payload_raw, str):
                    payload = json.loads(payload_raw)
                elif isinstance(payload_raw, dict):
                    payload = payload_raw
                else:
                    raise ValueError("Unsupported payload type")

                # Determine internal id and idempotency markers
                internal_id = payload.get("internal_id") or payload.get("id") or (msg_id + "_" + uuid.uuid4().hex[:6])
                idempotency_key = f"idempotency:{internal_id}"
                processing_lock = f"proc_lock:{internal_id}"

                # Acquire short processing lock (NX PX)
                got_lock = await redis_client.set(processing_lock, self.consumer_name, nx=True, px=settings.PROCESSING_LOCK_TTL)
                if not got_lock:
                    MET_MESSAGES_IDEMPOTENT.inc()
                    logger.info("Message %s already being processed by another consumer; skipping", internal_id)
                    # ack to remove from pending set? We choose to skip ack so pending claims remain; return True to avoid DLQ
                    return True

                try:
                    # Check final idempotency marker
                    if await redis_client.get(idempotency_key):
                        MET_MESSAGES_IDEMPOTENT.inc()
                        # acknowledge to remove from stream
                        await redis_client.xack(settings.REDIS_STREAM_INPUT, settings.REDIS_CONSUMER_GROUP, msg_id)
                        logger.info("Message %s already finalized previously; acked", internal_id)
                        return True

                    # Perform document processing (if any) and LLM assessment
                    # For generality, expect payload.normalized_form and files list
                    normalized_form = payload.get("normalized_form", {})
                    file_records = []
                    try:
                        files_json = payload.get("files") or "[]"
                        if isinstance(files_json, str):
                            file_records = json.loads(files_json)
                        elif isinstance(files_json, list):
                            file_records = files_json
                    except Exception:
                        file_records = []

                    # Optional: process files concurrently (e.g., decrypt, extract text)
                    extracted_text = await self._process_files(file_records)

                    # Build downstream payload for LLM
                    downstream = {
                        "internal_id": internal_id,
                        "normalized_form": normalized_form,
                        "extracted_text": extracted_text
                    }

                    # Call LLM or fallback
                    decision = await self._call_llm_with_fallback(downstream)

                    # Write output to result stream
                    out_stream = settings.REDIS_STREAM_INPUT + "_out"
                    await redis_client.xadd(out_stream, {"payload": json.dumps(decision)}, nomkstream=True, maxlen=100000, approximate=True)

                    # Mark final idempotency marker
                    await redis_client.set(idempotency_key, json.dumps({"processed_at": now_iso(), "consumer": self.consumer_name}), ex=settings.IDEMPOTENCY_TTL)

                    # Acknowledge original message
                    await redis_client.xack(settings.REDIS_STREAM_INPUT, settings.REDIS_CONSUMER_GROUP, msg_id)

                    MET_MESSAGES_PROCESSED.inc()
                    elapsed = time.time() - start
                    MET_PROCESS_LATENCY.observe(elapsed)
                    logger.info("Processed message %s successfully in %.3fs", internal_id, elapsed)
                    return True
                finally:
                    # release processing lock if still owned
                    try:
                        owner = await redis_client.get(processing_lock)
                        if owner == self.consumer_name:
                            await redis_client.delete(processing_lock)
                    except Exception:
                        logger.debug("Failed to release processing lock for %s", internal_id)
            except json.JSONDecodeError:
                MET_MESSAGES_FAILED.labels(error_type="JSON_DECODE").inc()
                logger.exception("JSON decode error for message %s", msg_id)
                await self._send_to_dlq(msg_id, data, "JSON_DECODE")
            except ValueError as e:
                MET_MESSAGES_FAILED.labels(error_type="VALIDATION").inc()
                logger.warning("Validation error for message %s: %s", msg_id, e)
                await self._send_to_dlq(msg_id, data, f"VALIDATION: {e}")
            except Exception as e:
                MET_MESSAGES_FAILED.labels(error_type=type(e).__name__).inc()
                logger.exception("Unexpected processing error for %s", msg_id)
                # send to DLQ
                await self._send_to_dlq(msg_id, data, f"UNEXPECTED: {type(e).__name__}")
        return False

    async def _send_to_dlq(self, msg_id: str, data: Dict[str, Any], error: str):
        """Write original message + error to DLQ and acknowledge original."""
        try:
            payload = {
                "original_msg_id": msg_id,
                "error": error,
                "data": json.dumps(data),
                "timestamp": now_iso()
            }
            await redis_client.xadd(settings.REDIS_DLQ_STREAM, payload, nomkstream=True, maxlen=100000, approximate=True)
            await redis_client.xack(settings.REDIS_STREAM_INPUT, settings.REDIS_CONSUMER_GROUP, msg_id)
            MET_DLQ_WRITTEN.inc()
            logger.warning("Sent msg %s to DLQ: %s", msg_id, error)
        except Exception:
            logger.exception("Failed to send to DLQ for %s", msg_id)

    async def _process_files(self, file_records: List[Dict[str, Any]]) -> Dict[str, str]:
        """Mock / extensible file processor — decrypts/reads files and extracts text.
        In production, hook to S3/GCS fetch, decrypt with KMS, OCR/parse etc.
        This implementation returns short mocked text snippets to avoid heavy deps.
        """
        if not file_records:
            return {}
        async def _single_process(record: Dict[str, Any]) -> Tuple[str, str]:
            filename = record.get("filename", "unknown")
            # Placeholder: fetch from S3 using s3 key if present. Simulate latency.
            await asyncio.sleep(0.01)
            return filename, f"mock-extracted-text-for-{filename}"[:1000]
        tasks = [asyncio.create_task(_single_process(r)) for r in file_records]
        results = await asyncio.gather(*tasks, return_exceptions=True)
        out: Dict[str, str] = {}
        for res in results:
            if isinstance(res, Exception):
                logger.debug("File processing error: %s", res)
                continue
            k, v = res
            out[k] = v
        return out

    async def _call_llm_with_fallback(self, payload: Dict[str, Any]) -> Dict[str, Any]:
        """Call LLM service with circuit breaker and fallback to rule-based assessment."""
        # short-circuit if circuit open
        if not await self._llm_circuit.allowed():
            logger.warning("LLM circuit open, using fallback for %s", payload.get("internal_id"))
            MET_LLM_CALLS.labels(status="circuit_open").inc()
            return self._rule_based_decision(payload)

        prompt = self._build_prompt(payload)
        try:
            start = time.time()
            result = await self._call_llm(prompt)
            MET_LLM_LATENCY.observe(time.time() - start)
            await self._llm_circuit.record_success()
            MET_LLM_CALLS.labels(status="success").inc()
            return result
        except Exception as e:
            logger.warning("LLM call failed: %s; falling back: %s", type(e).__name__, e)
            await self._llm_circuit.record_failure()
            MET_LLM_CALLS.labels(status="error").inc()
            return self._rule_based_decision(payload)

    def _build_prompt(self, payload: Dict[str, Any]) -> str:
        nf = payload.get("normalized_form", {})
        docs = payload.get("extracted_text", {})
        # keep prompt concise
        return f"Applicant: {json.dumps(nf)}\nDocuments summary: {json.dumps(docs)[:1000]}\nReturn JSON: {{'decision': 'APPROVED|REVIEW|DECLINED','risk_score':0.0-1.0,'reasoning':'short'}}"

    async def _call_llm(self, prompt: str) -> Dict[str, Any]:
        """LLM call wrapped with retries and concurrency limit."""
        async with LLM_SEMAPHORE:
            # Tenacity-style retry using AsyncRetrying for async
            async for attempt in AsyncRetrying(
                stop=stop_after_attempt(settings.LLM_RETRIES),
                wait=wait_exponential(multiplier=1, min=1, max=8),
                retry=retry_if_exception_type((httpx.RequestError, httpx.HTTPStatusError, asyncio.TimeoutError))
            ):
                with attempt:
                    # Use httpx async client
                    resp = await llm_client.post("/chat/completions", json={
                        "model": settings.LLM_MODEL,
                        "messages": [{"role": "user", "content": prompt}],
                        "temperature": 0.1
                    })
                    resp.raise_for_status()
                    body = resp.json()
                    # defensive extraction
                    choices = body.get("choices") or []
                    if not choices:
                        raise ValueError("LLM returned no choices")
                    content = choices[0].get("message", {}).get("content", "") or ""
                    # attempt parse of JSON object
                    parsed = self._extract_first_json(content)
                    if not parsed:
                        # return raw text wrapped as fallback
                        return {"internal_id": payload.get("internal_id"), "decision": "REVIEW", "risk_score": 0.5, "reasoning": content}
                    return parsed
            # if retries exhausted, this point reached and exception propagated

    def _extract_first_json(self, s: str) -> Optional[Dict[str, Any]]:
        """Balanced-brace extractor similar to producer-side counterpart."""
        if not s:
            return None
        start = None
        depth = 0
        in_str = False
        esc = False
        for i, ch in enumerate(s):
            if ch == '"' and not esc:
                in_str = not in_str
            if in_str and ch == "\\" and not esc:
                esc = True
                continue
            else:
                esc = False
            if not in_str:
                if ch == "{":
                    if start is None:
                        start = i
                    depth += 1
                elif ch == "}":
                    depth -= 1
                    if start is not None and depth == 0:
                        try:
                            return json.loads(s[start:i+1])
                        except Exception:
                            return None
        return None

    def _rule_based_decision(self, payload: Dict[str, Any]) -> Dict[str, Any]:
        nf = payload.get("normalized_form", {})
        score = 0.5
        if nf.get("smoker"):
            score += 0.25
        bmi = nf.get("bmi", 0) or 0
        if bmi > 30:
            score += 0.2
        age = nf.get("age", 40) or 40
        if age < 21 or age > 70:
            score += 0.2
        score = min(1.0, score)
        if score < 0.4:
            decision = "APPROVED"
        elif score < 0.75:
            decision = "REVIEW"
        else:
            decision = "DECLINED"
        return {
            "internal_id": payload.get("internal_id"),
            "decision": decision,
            "risk_score": score,
            "reasoning": f"Rule fallback (smoker={nf.get('smoker')}, bmi={bmi}, age={age})"
        }

    async def consumer_loop(self):
        """Main consumer loop: read messages, dispatch to workers, manage concurrency and trimming."""
        logger.info("Consumer loop starting as consumer=%s", self.consumer_name)
        while not self.shutdown_event.is_set():
            try:
                # Read group messages (new)
                read_count = min(settings.REDIS_STREAM_READ_COUNT, self._concurrency * settings.BATCH_SIZE)
                msgs = await redis_client.xreadgroup(
                    groupname=settings.REDIS_CONSUMER_GROUP,
                    consumername=self.consumer_name,
                    streams={settings.REDIS_STREAM_INPUT: ">"},
                    count=read_count,
                    block=int(settings.READ_BLOCK_MS)
                )
                # msgs: list of (stream, [(msgid, {k:v})])
                if not msgs:
                    # Periodic housekeeping: check pending, trim streams
                    await self._housekeeping()
                    await asyncio.sleep(settings.POLL_SLEEP_EMPTY_SEC)
                    continue

                # prepare tasks
                entries = []
                for stream_name, records in msgs:
                    for msg_id, data in records:
                        entries.append((msg_id, data))

                MET_IN_FLIGHT.set(len(entries))
                # dispatch tasks in bounded concurrency batches using TaskGroup (Python 3.11+)
                async with asyncio.TaskGroup() as tg:
                    for msg_id, data in entries:
                        # throttle by semaphore
                        await self._semaphore.acquire()
                        tg.create_task(self._task_wrapper(msg_id, data))
                MET_IN_FLIGHT.set(0)
                # after batch, adaptive concurrency adjust
                await self._adaptive_adjustments()
            except Exception as e:
                MET_CONSUMER_ERRORS.inc()
                logger.exception("Consumer loop exception: %s", e)
                # Backoff on repeated failures
                await asyncio.sleep(1.0)

        logger.info("Consumer loop exiting due to shutdown signal")

    async def _task_wrapper(self, msg_id: str, data: Dict[str, Any]):
        """Wrap the processing and ensure semaphore release."""
        try:
            await self._process_entry(msg_id, data)
        finally:
            try:
                self._semaphore.release()
            except Exception:
                pass

    async def _housekeeping(self):
        """Cleanup: trim streams, check pending, set metrics for pending messages."""
        try:
            # xlen approximate
            length = await redis_client.xlen(settings.REDIS_STREAM_INPUT)
            MET_PENDING.set(length)
            # trim out stream
            await redis_client.xtrim(settings.REDIS_STREAM_INPUT + "_out", maxlen=100000, approximate=True)
        except Exception:
            logger.debug("Housekeeping encountered an error", exc_info=True)

    async def _adaptive_adjustments(self):
        """Adjust concurrency based on latency history and pending messages."""
        try:
            # compute avg latency
            if self._latency_history:
                avg = sum(self._latency_history) / len(self._latency_history)
            else:
                avg = 0.0
            pending = await redis_client.xlen(settings.REDIS_STREAM_INPUT)
            # Simple policy: increase concurrency if pending high and avg low, else decrease
            if pending > settings.BATCH_SIZE * 4 and self._concurrency < settings.MAX_CONCURRENCY and avg < 2.0:
                self._concurrency = min(self._concurrency + 4, settings.MAX_CONCURRENCY)
                for _ in range(4):
                    self._semaphore.release()  # expand available slots
                logger.info("Increased concurrency to %d (pending=%d, avg_latency=%.2f)", self._concurrency, pending, avg)
            elif pending < settings.BATCH_SIZE and self._concurrency > settings.CONCURRENCY_BASE:
                dec = min(4, self._concurrency - settings.CONCURRENCY_BASE)
                for _ in range(dec):
                    # reduce semaphore slots by acquiring them permanently
                    await self._semaphore.acquire()
                self._concurrency -= dec
                logger.info("Decreased concurrency to %d (pending=%d, avg_latency=%.2f)", self._concurrency, pending, avg)
        except Exception:
            logger.debug("Adaptive adjustments failed", exc_info=True)

