from fakeredis.aioredis import FakeRedis
from unittest.mock import AsyncMock, MagicMock

from worker.service import WorkerService
from worker import metrics
from prometheus_client import CollectorRegistry, Counter


# -------------------------
# Constants
# -------------------------
STREAM_IN = "advice_in"
STREAM_OUT = "advice_out"
DLQ = "dlq"

BATCH_SIZE = 100
THROUGHPUT_THRESHOLD_MSG_PER_SEC = 500  # Soft threshold – used only for xfail in load tests


# -------------------------
# Helpers
# -------------------------
async def clear_streams(redis: FakeRedis) -> None:
    await asyncio.gather(
        redis.delete(STREAM_IN),
        redis.delete(STREAM_OUT),
        redis.delete(DLQ),
    )


def reinitialize_metrics() -> None:
    """Reinitialize all metrics with a fresh isolated registry for test independence."""
    registry = CollectorRegistry()

    metrics.MET_MESSAGES_RECEIVED = Counter(
        "messages_received",
        "Total messages received from input stream",
        registry=registry,
    )
    metrics.MET_MESSAGES_PROCESSED = Counter(
        "messages_processed",
        "Total messages successfully processed",
        registry=registry,
    )
    metrics.MET_MESSAGES_FAILED = Counter(
        "messages_failed",
        "Total messages that failed processing",
        registry=registry,
    )
    # Update the global registry reference if your app uses default
    metrics.REGISTRY = registry


def get_metrics_snapshot() -> Dict[str, float]:
    """Read current metric values using the official collect API."""
    snapshot = {"received": 0.0, "processed": 0.0, "failed": 0.0}
    for metric in metrics.REGISTRY.collect():
        for sample in metric.samples:
            if sample.name in snapshot:
                snapshot[sample.name] = float(sample.value)
    return snapshot


async def preload_messages(redis: FakeRedis, total: int) -> None:
    """Pre-load messages with bounded concurrency to prevent event loop overload."""
    semaphore = asyncio.Semaphore(200)  # Safe concurrency limit even under large volumes

    async def add_message(i: int):
        async with semaphore:
            payload = json.dumps({"user_id": i, "age": 20 + i % 50}).encode("utf-8")
            await redis.xadd(STREAM_IN, {b"payload": payload})

    tasks = [add_message(i) for i in range(total)]
    # Process in chunks to avoid creating millions of tasks at once
    for i in range(0, len(tasks), 1000):
        await asyncio.gather(*tasks[i : i + 1000])


async def verify_output_stream(redis: FakeRedis, expected_count: int, max_attempts: int = 20) -> None:
    """Poll output stream until stable at expected count, with early exit."""
    prev_count = -1
    for _ in range(max_attempts):
        entries = await redis.xrange(STREAM_OUT, "-", "+")
        current_count = len(entries)
        if current_count == expected_count and current_count == prev_count:
            # Validate payload structure on all entries
            for _, data in entries:
                payload = json.loads(data[b"payload"].decode("utf-8"))
                assert payload["decision"] == "APPROVED"
                assert "risk_score" in payload
                assert "reasoning" in payload
            return
        prev_count = current_count
        await asyncio.sleep(0.5)
    raise AssertionError(f"Output stream did not stabilize at {expected_count} (last: {prev_count})")


