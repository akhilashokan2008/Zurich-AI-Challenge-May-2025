# -------------------------
# Constants
# -------------------------
TEST_CONFIGS = [
    (1000, 5, 0.005),     # Small: 1k messages, 5 concurrency, 5ms latency
    (5000, 10, 0.01)      # Medium: 5k messages, 10 concurrency, 10ms latency
]

FULL_STRESS_MSGS = 50_000
FULL_STRESS_CONCURRENCY = 20
SIMULATED_LATENCY = 0.05
BATCH_SIZE = 100
THROUGHPUT_THRESHOLD = 500  # messages/sec for soft check

# -------------------------
# Helpers
# -------------------------
async def clear_streams(redis_client):
    await asyncio.gather(
        redis_client.delete("advice_in"),
        redis_client.delete("advice_out"),
        redis_client.delete("dlq")
    )

def make_payload(data):
    return {b"payload": json.dumps(data).encode("utf-8")}

def reset_worker_metrics():
    """Safely reset metrics using public API."""
    for m in [metrics.MET_MESSAGES_RECEIVED, metrics.MET_MESSAGES_PROCESSED, metrics.MET_MESSAGES_FAILED]:
        current = m._value.get()
        m.inc(-current)

