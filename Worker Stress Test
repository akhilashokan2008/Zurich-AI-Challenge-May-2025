@pytest_asyncio.fixture
def concurrency_tracker() -> Tuple[asyncio.Lock, dict]:
    tracker = {"current": 0, "peak": 0}
    lock = asyncio.Lock()
    return lock, tracker


# -------------------------
# Core runner
# -------------------------
async def run_worker_and_verify(
    worker: WorkerService,
    total_messages: int,
    concurrency_limit: int,
    simulated_latency: float,
    concurrency_tracker: Tuple[asyncio.Lock, dict],
    mock_audit: AsyncMock,
    max_poll_attempts: int = 20,
) -> float:
    lock, tracker = concurrency_tracker
    original_send = worker.llm_client.send

    async def instrumented_send(*args, **kwargs):
        async with lock:
            tracker["current"] += 1
            tracker["peak"] = max(tracker["peak"], tracker["current"])
        await asyncio.sleep(simulated_latency)
        async with lock:
            tracker["current"] -= 1
        return await original_send(*args, **kwargs)

    worker.llm_client.send.side_effect = instrumented_send

    start_time = time.perf_counter()

    try:
        await asyncio.wait_for(worker.drain_stream(STREAM_IN), timeout=300)
    except asyncio.TimeoutError:
        snapshot = get_metrics_snapshot()
        raise pytest.fail(
            f"drain_stream timed out after 300s. "
            f"Metrics: {snapshot} | Peak concurrency: {tracker['peak']}"
        )

    duration = time.perf_counter() - start_time
    throughput = total_messages / duration if duration > 0 else 0

    # Core assertions
    assert tracker["peak"] <= concurrency_limit

    snapshot = get_metrics_snapshot()
    assert snapshot["received"] == total_messages
    assert snapshot["processed"] == total_messages
    assert snapshot["failed"] == 0

    await verify_output_stream(worker.redis, total_messages, max_poll_attempts)

    # Audit: count + sample content validation
    assert mock_audit.record.call_count == total_messages
    if total_messages > 0:
        sample_call = mock_audit.record.call_args_list[0]
        event_data = sample_call.kwargs.get("event", {})
        assert "user_id" in str(event_data)  # Loose but ensures key propagation

    # Soft throughput check only on large runs
    if total_messages > 10_000 and throughput < THROUGHPUT_THRESHOLD_MSG_PER_SEC:
        pytest.xfail(f"Throughput {throughput:.2f} msg/s below soft threshold (host-dependent)")

    return throughput


# -------------------------
# Fast correctness tests
# -------------------------
@pytest.mark.parametrize(
    "total_messages, concurrency_limit, simulated_latency, max_poll",
    [
        (500, 5, 0.001, 10),
        (1_000, 10, 0.005, 12),
        (2_000, 15, 0.01, 15),
    ],
)
@pytest.mark.asyncio
async def test_worker_correctness_and_concurrency(
    worker_service: WorkerService,
    redis: FakeRedis,
    concurrency_tracker: Tuple[asyncio.Lock, dict],
    mock_audit: AsyncMock,
    total_messages: int,
    concurrency_limit: int,
    simulated_latency: float,
    max_poll: int,
):
    worker_service.concurrency = concurrency_limit
    worker_service.semaphore = asyncio.Semaphore(concurrency_limit)

    await clear_streams(redis)
    await preload_messages(redis, total_messages)

    await run_worker_and_verify(
        worker_service,
        total_messages,
        concurrency_limit,
        simulated_latency,
        concurrency_tracker,
        mock_audit,
        max_poll_attempts=max_poll,
    )


