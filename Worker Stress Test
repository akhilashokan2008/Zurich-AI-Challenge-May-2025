# -------------------------
# Core Functions
# -------------------------
async def preload_messages(redis, stream_name, total_messages):
    sem_limit = min(500, max(50, total_messages // 100))
    sem = asyncio.Semaphore(sem_limit)

    async def safe_xadd(i):
        async with sem:
            await redis.xadd(stream_name, make_payload({"user_id": i, "age": 20 + i % 50}))

    await asyncio.gather(*[safe_xadd(i) for i in range(total_messages)])

async def run_processing_loop(worker_svc, concurrency_lock, total_messages, concurrency_limit, simulated_latency):
    active = {"current": 0, "max": 0}
    original_send = worker_svc.llm_client.send

    async def instrumented_send(*args, **kwargs):
        async with concurrency_lock:
            active["current"] += 1
            active["max"] = max(active["max"], active["current"])
        await asyncio.sleep(simulated_latency)
        async with concurrency_lock:
            active["current"] -= 1
        return await original_send(*args, **kwargs)

    worker_svc.llm_client.send.side_effect = instrumented_send

    total_batches = 0
    start_time = time.time()

    async def process_batches():
        nonlocal total_batches
        while True:
            batch = await worker_svc._fetch_batch("advice_in")
            if not batch:
                break
            metrics.MET_MESSAGES_RECEIVED.inc(len(batch))
            await worker_svc._process_batch("advice_in", batch)
            await asyncio.sleep(0)
            total_batches += 1

    try:
        await asyncio.wait_for(process_batches(), timeout=300)
    except asyncio.TimeoutError:
        pytest.fail("Processing loop timed out after 300s")

    total_duration = time.time() - start_time
    throughput = total_messages / total_duration if total_duration > 0 else 0

    # Concurrency check
    assert active["max"] <= concurrency_limit, f"Max concurrency {active['max']} exceeded {concurrency_limit}"

    # Throughput soft check
    if total_messages > 10000 and throughput < THROUGHPUT_THRESHOLD:
        pytest.xfail(f"Throughput {throughput:.2f} < {THROUGHPUT_THRESHOLD} msg/sec for large run")

    # Metrics check
    assert metrics.MET_MESSAGES_RECEIVED._value.get() == total_messages
    assert metrics.MET_MESSAGES_PROCESSED._value.get() == total_messages
    assert metrics.MET_MESSAGES_FAILED._value.get() == 0

    # Output check
    out_entries = []
    for _ in range(10):
        out_entries = await worker_svc.redis.xrange("advice_out", "-", "+")
        if len(out_entries) == total_messages:
            break
        await asyncio.sleep(0.5)
    assert len(out_entries) == total_messages

    # Payload validation
    for _, data in out_entries:
        payload = json.loads(data[b"payload"].decode("utf-8"))
        assert payload["decision"] == "APPROVED"
        assert "risk_score" in payload
        assert "reasoning" in payload

# -------------------------
# Test Cases
# -------------------------
@pytest.mark.parametrize("worker,total_messages,concurrency,simulated_latency", TEST_CONFIGS, indirect=["worker"])
@pytest.mark.asyncio
async def test_concurrency_limits(worker, redis_client, concurrency_lock, total_messages, concurrency, simulated_latency):
    await clear_streams(redis_client)
    await preload_messages(redis_client, "advice_in", total_messages)
    await run_processing_loop(worker, concurrency_lock, total_messages, concurrency, simulated_latency)

@pytest.mark.asyncio
async def test_high_volume_throughput(worker, redis_client, concurrency_lock):
    # Explicitly reset worker for full stress
    worker.concurrency = FULL_STRESS_CONCURRENCY
    worker.semaphore = asyncio.Semaphore(FULL_STRESS_CONCURRENCY)
    await clear_streams(redis_client)
    await preload_messages(redis_client, "advice_in", FULL_STRESS_MSGS)
    await run_processing_loop(worker, concurrency_lock, FULL_STRESS_MSGS, FULL_STRESS_CONCURRENCY, SIMULATED_LATENCY)