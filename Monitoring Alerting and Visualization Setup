# ========================================================================
# Policy LLM Service Monitoring - v1.2.0-next
# ========================================================================

metadata:
  name: policy-llm-monitoring-v1-2-0-next
  namespace: monitoring
  labels:
    version: v1.2.0-next

# ========================================================================
# Prometheus Alert Rules
# ========================================================================

prometheusRules:
  apiVersion: monitoring.coreos.com/v1
  kind: PrometheusRule
  metadata:
    name: policy-llm-alerts-v1-2-0-next
    namespace: monitoring
  spec:
    groups:
      - name: policy-llm.rules
        rules:

          # High API latency (95th percentile)
          - alert: HighAPIInferenceLatency
            expr: histogram_quantile(0.95, sum by (le, endpoint, service) (rate(policy_llm_api_latency_seconds_bucket{namespace=~"prod|staging"}[5m]))) > 0.5
            for: 5m
            labels:
              severity: warning
              service: policy-llm
              team: ml-ops
            annotations:
              summary: High inference latency
              description: "95th percentile API latency exceeded 500ms for {{ $labels.endpoint }}"

          # High API error rate
          - alert: HighAPIErrorRate
            expr: (sum(rate(http_requests_total{namespace=~"prod|staging", service="policy-llm", status=~"5.."}[5m])) by (service)) / clamp_min(sum(rate(http_requests_total{namespace=~"prod|staging", service="policy-llm"}[5m])) by (service),1) > 0.05
            for: 5m
            labels:
              severity: critical
              service: policy-llm
              team: ml-ops
            annotations:
              summary: High API error rate
              description: "More than 5% of API requests failing in last 5 minutes"

          # Function slowdown
          - alert: FunctionSlowdown
            expr: histogram_quantile(0.95, sum by (le, function, service) (rate(function_latency_seconds_bucket{namespace=~"prod|staging"}[5m]))) > 2
            for: 5m
            labels:
              severity: warning
              service: policy-llm
              team: ml-ops
            annotations:
              summary: Function slowdown
              description: "95th percentile execution time of function {{ $labels.function }} exceeded 2s"

          # LLM Offline & abnormalities
          - alert: LLMOffline
            expr: sum(policy_llm_up{namespace=~"prod|staging"}) by (service) == 0
            for: 3m
            labels:
              severity: critical
              service: policy-llm
              team: ml-ops
            annotations:
              summary: LLM service offline
              description: "LLM service is not responding"

          - alert: LLMAbnormalities
            expr: increase(llm_abnormalities_total{namespace=~"prod|staging"}[5m]) > 0
            for: 5m
            labels:
              severity: critical
              service: policy-llm
              team: ml-ops
            annotations:
              summary: LLM abnormalities
              description: "Detected {{ $value }} LLM anomalies in the last 5 minutes"

          # Batch queue backlog
          - alert: BatchQueueLengthHigh
            expr: batch_queue_length{namespace=~"prod|staging"} > 50
            for: 5m
            labels:
              severity: warning
              service: policy-llm
            annotations:
              summary: Batch queue backlog
              description: "Pending batch jobs exceed 50"

          # Redis / Kafka
          - alert: RedisUnavailable
            expr: sum(redis_up{namespace=~"prod|staging"}) by (service) == 0
            for: 5m
            labels:
              severity: critical
              service: policy-llm
              team: infra
            annotations:
              summary: Redis offline
              description: "Redis service unavailable"

          - alert: KafkaUnavailable
            expr: sum(kafka_broker_up{namespace=~"prod|staging"}) by (service) == 0
            for: 5m
            labels:
              severity: critical
              service: policy-llm
              team: infra
            annotations:
              summary: Kafka offline
              description: "Kafka broker unavailable"

          # Internet / Electricity
          - alert: InternetOffline
            expr: sum(internet_up{namespace=~"prod|staging"}) by (service) == 0
            for: 5m
            labels:
              severity: warning
              service: policy-llm
              team: infra
            annotations:
              summary: Internet offline
              description: "Internet connectivity down"

          - alert: ElectricityOffline
            expr: sum(electricity_up{namespace=~"prod|staging"}) by (service) == 0
            for: 5m
            labels:
              severity: warning
              service: policy-llm
              team: infra
            annotations:
              summary: Electricity offline
              description: "Power outage detected"

          # Security
          - alert: CyberAttackDetected
            expr: increase(cyber_attack_detected_total{namespace=~"prod|staging"}[5m]) > 0
            for: 5m
            labels:
              severity: critical
              service: policy-llm
              team: security
            annotations:
              summary: Possible cyber attack
              description: "New cyber attacks detected in last 5 minutes"

          - alert: BreakInAttempt
            expr: increase(break_in_attempt_total{namespace=~"prod|staging"}[5m]) > 0
            for: 5m
            labels:
              severity: critical
              service: policy-llm
              team: security
            annotations:
              summary: Unauthorized access attempt
              description: "Break-in attempts detected in last 5 minutes"

          # Blackbox Exporter
          - alert: BlackboxHTTPDown
            expr: probe_http_status_code{module="http_2xx", namespace=~"prod|staging"} != 200
            for: 5m
            labels:
              severity: critical
              service: policy-llm
              team: infra
            annotations:
              summary: Blackbox HTTP failure
              description: "HTTP probe returned non-200 status"

          - alert: BlackboxSSLExpiry
            expr: probe_ssl_earliest_cert_expiry{module="http_2xx", namespace=~"prod|staging"} - time() < 86400*7
            for: 0m
            labels:
              severity: warning
              service: policy-llm
              team: infra
            annotations:
              summary: SSL certificate expiry
              description: "SSL certificate expires in less than 7 days"

          - alert: BlackboxDNSLatencyHigh
            expr: probe_dns_lookup_time_seconds{module="http_2xx", namespace=~"prod|staging"} > 0.5
            for: 5m
            labels:
              severity: warning
              service: policy-llm
              team: infra
            annotations:
              summary: DNS resolution latency
              description: "DNS lookup time exceeded 500ms"

# ========================================================================
# Grafana Dashboard JSON
# ========================================================================

grafanaDashboard:
  id: null
  title: "Policy LLM Service Monitoring - v1.2.0-next"
  uid: "policy-llm-dashboard-v1-2-0-next"
  timezone: "browser"
  panels:
    - type: "graph"
      title: "API Latency (95th percentile)"
      targets:
        - expr: histogram_quantile(0.95, sum by (le, endpoint, service) (rate(policy_llm_api_latency_seconds_bucket{namespace=~"prod|staging"}[5m])))
          legendFormat: "{{service}}:{{endpoint}}"
          refId: "A"
      thresholds:
        - value: 0.5
          colorMode: "critical"
          line: true
    - type: "graph"
      title: "Function Latency (95th percentile)"
      targets:
        - expr: histogram_quantile(0.95, sum by (le, function, service) (rate(function_latency_seconds_bucket{namespace=~"prod|staging"}[5m])))
          legendFormat: "{{service}}:{{function}}"
          refId: "B"
      thresholds:
        - value: 2
          colorMode: "warning"
          line: true
    - type: "stat"
      title: "LLM Status & Abnormalities"
      targets:
        - expr: sum(policy_llm_up{namespace=~"prod|staging"}) by (service)
          legendFormat: "LLM Up"
          refId: "C"
        - expr: increase(llm_abnormalities_total{namespace=~"prod|staging"}[5m])
          legendFormat: "Abnormalities"
          refId: "D"
    - type: "graph"
      title: "Batch Queue Length"
      targets:
        - expr: batch_queue_length{namespace=~"prod|staging"}
          legendFormat: "Pending Jobs"
          refId: "E"
      thresholds:
        - value: 50
          colorMode: "warning"
          line: true
    - type: "stat"
      title: "Redis & Kafka Status"
      targets:
        - expr: sum(redis_up{namespace=~"prod|staging"}) by (service)
          legendFormat: "Redis Up"
          refId: "F"
        - expr: sum(kafka_broker_up{namespace=~"prod|staging"}) by (service)
          legendFormat: "Kafka Up"
          refId: "G"
    - type: "stat"
      title: "Internet & Electricity"
      targets:
        - expr: sum(internet_up{namespace=~"prod|staging"}) by (service)
          legendFormat: "Internet Up"
          refId: "H"
        - expr: sum(electricity_up{namespace=~"prod|staging"}) by (service)
          legendFormat: "Power Up"
          refId: "I"
    - type: "graph"
      title: "Security Events"
      targets:
        - expr: increase(cyber_attack_detected_total{namespace=~"prod|staging"}[5m])
          legendFormat: "Cyber Attacks"
          refId: "J"
        - expr: increase(break_in_attempt_total{namespace=~"prod|staging"}[5m])
          legendFormat: "Break-in Attempts"
          refId: "K"

# ========================================================================
# Runbooks / Actionable Mapping
# ========================================================================

runbooks:
  HighAPIInferenceLatency:
    - step: "Confirm alert repeatability"
    - step: "Check API latency metrics per endpoint and service"
    - step: "Inspect dependent services (Redis, Kafka, downstream APIs)"
    - step: "Scale pods or inference workers if needed"
    - step: "Escalate to ML-Ops if persists"
    - escalation_policy: "Page ML-Ops L2 if unresolved after 15 minutes"

  HighAPIErrorRate:
    - step: "Verify alert repeatability"
    - step: "Check HTTP 5xx/4xx logs per service"
    - step: "Check Redis/Kafka connectivity"
    - step: "Investigate LLM endpoint errors"
    - escalation_policy: "Page ML-Ops L2 if error ratio remains above threshold"

  FunctionSlowdown:
    - step: "Verify alert repeatability"
    - step: "Identify function via 'function' label"
    - step: "Inspect function metrics and bottlenecks"
    - step: "Review recent deployments or changes"
    - step: "Scale resources if required"
    - escalation_policy: "Page ML-Ops L2 if slowdown persists"

  LLMOffline:
    - step: "Verify alert repeatability"
    - step: "Check LLM pods and logs"
    - step: "Restart LLM if necessary"
    - step: "Notify ML-Ops team"

  LLMAbnormalities:
    - step: "Confirm increase in abnormalities"
    - step: "Check LLM outputs and performance"
    - step: "Restart LLM if necessary"
    - step: "Escalate to ML-Ops team"

  RedisUnavailable:
    - step: "Check Redis pod health and logs"
    - step: "Test network connectivity"
    - step: "Failover to backup Redis if configured"
    - escalation_policy: "Notify Infra team"

  KafkaUnavailable:
    - step: "Check Kafka broker and connectivity"
    - step: "Inspect producer/consumer failures"
    - escalation_policy: "Notify Infra team"

  InternetOffline:
    - step: "Verify alert repeatability"
    - step: "Check network provider and routing"
    - escalation_policy: "Notify Infra team"

  ElectricityOffline:
    - step: "Verify alert repeatability"
    - step: "Check UPS and power supply"
    - escalation_policy: "Notify Infra team"

  CyberAttackDetected:
    - step: "Confirm new events"
    - step: "Investigate source IPs and attack vector"
    - step: "Block malicious actors if needed"
    - escalation_policy: "Page Security team L2 immediately"

  BreakInAttempt:
    - step: "Check authentication logs"
    - step: "Investigate compromised accounts"
    - escalation_policy: "Page Security team L2 immediately"

  BlackboxHTTPDown:
    - step: "Verify HTTP probe"
    - step: "Check service endpoint"
    - escalation_policy: "Notify Infra team"

  BlackboxSSLExpiry:
    - step: "Check SSL certificate expiry"
    - step: "Rotate certificate if necessary"
    - escalation_policy: "Notify Infra team"

  BlackboxDNSLatencyHigh:
    - step: "Check DNS server and probe configuration"
    - step: "Investigate resolution delays"
    - escalation_policy: "Notify Infra team"