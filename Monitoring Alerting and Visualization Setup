apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: policy-llm-recording-rules
  labels:
    service: policy-llm
    team: ml-infra
    tier: enterprise
spec:
  groups:
    - name: policy-llm.slo.recordings
      rules:
        # Fast error rate (≈1% error budget burn over 5m)
        - record: policy_llm:http_error_rate:5m
          expr: |
            sum by (model) (
              rate(http_requests_total{service="policy-llm",status=~"5.."}[5m])
            )
            /
            clamp_min(
              sum by (model) (
                rate(http_requests_total{service="policy-llm"}[5m])
              ),
              1
            )

        # Slow error rate (sustained burn confirmation)
        - record: policy_llm:http_error_rate:1h
          expr: |
            sum by (model) (
              rate(http_requests_total{service="policy-llm",status=~"5.."}[1h])
            )
            /
            clamp_min(
              sum by (model) (
                rate(http_requests_total{service="policy-llm"}[1h])
              ),
              1
            )

        # Token latency SLO — P95 TPOT
        - record: policy_llm:tpot_p95:2m
          expr: |
            histogram_quantile(
              0.95,
              sum by (le, model) (
                rate(llm_tpot_seconds_bucket{service="policy-llm"}[2m])
              )
            )

    - name: policy-llm.saturation.recordings
      rules:
        # GPU utilization (consistent labels)
        - record: policy_llm:gpu_utilization:avg
          expr: |
            avg by (model, node) (
              gpu_utilization{service="policy-llm"}
            )

        # Queue growth rate (preferred saturation signal)
        - record: policy_llm:queue_growth_rate:5m
          expr: |
            rate(queue_depth{service="policy-llm"}[5m])

apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: policy-llm-alerts
  labels:
    service: policy-llm
    team: ml-infra
spec:
  groups:
    - name: policy-llm.performance
      rules:
        - alert: LLMTokenGenerationSlowdown
          # SLO: P95 TPOT > 40ms for 3m
          expr: policy_llm:tpot_p95:2m > 0.04
          for: 3m
          labels:
            service: policy-llm
            severity: warning
            remediation_plan: scale-inference-workers
            pager_scope: ml
            sla_level: tier2
          annotations:
            summary: "TPOT SLO violation"
            description: "P95 token generation latency exceeds 40ms."

        - alert: LLMErrorBudgetBurningFast
          # ≈1% error budget burn over 5m
          expr: policy_llm:http_error_rate:5m > 0.01
          for: 2m
          labels:
            service: policy-llm
            severity: critical
            remediation_plan: region-failover
            pager_scope: ml
            sla_level: tier1
          annotations:
            summary: "Fast error budget burn detected"

        - alert: LLMErrorBudgetBurningSlow
          expr: policy_llm:http_error_rate:1h > 0.005
          for: 10m
          labels:
            service: policy-llm
            severity: critical
            pager_scope: ml
            sla_level: tier1
          annotations:
            summary: "Sustained error budget burn"

        - alert: LLMSaturationDetected
          # Queue growth indicates saturation earlier than raw GPU %
          expr: policy_llm:queue_growth_rate:5m > 50
          for: 5m
          labels:
            service: policy-llm
            severity: warning
            pager_scope: ml
          annotations:
            summary: "Inference queue growing abnormally"

    - name: policy-llm.security
      rules:
        - alert: SecurityAgentHighRiskSignal
          expr: |
            avg_over_time(
              siem_threat_confidence_score{service="policy-llm"}[5m]
            ) > 0.85
            and
            rate(
              http_requests_total{
                service="policy-llm",
                status=~"5.."
              }[5m]
            ) > 0.01
          for: 5m
          labels:
            service: policy-llm
            severity: critical
            remediation_plan: security-mitigation
            pager_scope: security
            sla_level: tier1
          annotations:
            summary: "High-confidence security threat with server errors"

apiVersion: automation.enterprise.io/v1
kind: RemediationPlan
metadata:
  name: scale-inference-workers
  labels:
    service: policy-llm
    team: ml-infra
spec:
  triggerAlert: LLMTokenGenerationSlowdown
  safety:
    maxActionsPerDay: 3
    failOpen: true
    fallbackAction: NotifyOnCall
  audit:
    emitEvents: true
  actions:
    - step: 1
      action: VerticalPodAutoscaling
      target: deployment/inference-workers
      parameters:
        increment: 2
        max: 20
      cooldown: 10m

apiVersion: automation.enterprise.io/v1
kind: RemediationPlan
metadata:
  name: region-failover
  labels:
    service: policy-llm
    team: ml-infra
spec:
  triggerAlert: LLMErrorBudgetBurningFast
  safety:
    maxActionsPerDay: 1
    failOpen: true
    fallbackAction: FreezeTrafficShift
  audit:
    emitEvents: true
  actions:
    - step: 1
      action: TrafficShift
      provider: CloudMesh
      target: region-us-east-2
      parameters:
        weight: 10
      cooldown: 10m

apiVersion: automation.enterprise.io/v1
kind: RemediationPlan
metadata:
  name: security-mitigation
  labels:
    service: policy-llm
    team: security
spec:
  triggerAlert: SecurityAgentHighRiskSignal
  safety:
    maxActionsPerDay: 2
    failOpen: false
  audit:
    emitEvents: true
  actions:
    - step: 1
      action: EnableAggressiveWAFRateLimit
      cooldown: 10m
    - step: 2
      action: RotateServiceMeshCerts
      cooldown: 20m

resource "prometheus_rule" "policy_llm_alerts" {
  group_name = "policy-llm-v2"

  rule {
    alert = "LLMTokenGenerationSlowdown"
    expr  = "policy_llm:tpot_p95:2m > 0.04"
    for   = "3m"
    labels = {
      service  = "policy-llm"
      severity = "warning"
      team     = "ml-infra"
    }
  }
}

local grafana = import 'github.com/grafonnet/grafonnet-lib/grafonnet/grafana.libsonnet';

grafana.dashboard.new(
  title='Policy LLM — SLO & Saturation',
  uid=std.extVar('DASHBOARD_UID'),
  editable=false,
  schemaVersion=37,
)
.addPanel(
  grafana.timeSeries.new(
    title='TPOT P95 (SLO: 40ms)',
    unit='s',
  )
  .addTarget(
    grafana.prometheus.target('policy_llm:tpot_p95:2m')
  )
)
.addPanel(
  grafana.timeSeries.new(
    title='Error Budget Burn (Fast vs Slow)',
  )
  .addTarget(
    grafana.prometheus.target('policy_llm:http_error_rate:5m')
  )
  .addTarget(
    grafana.prometheus.target('policy_llm:http_error_rate:1h')
  )
)
.addPanel(
  grafana.timeSeries.new(
    title='Inference Queue Growth Rate',
  )
  .addTarget(
    grafana.prometheus.target('policy_llm:queue_growth_rate:5m')
  )
)
