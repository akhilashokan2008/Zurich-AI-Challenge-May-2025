@app.post("/infer", response_model=PolicyResponse, dependencies=[Depends(rate_limit_check)])
async def infer_policy(
    request: PolicyRequest,
    auth: Dict = Depends(verify_jwt_token),
    redis=Depends(get_redis),
    audit_logger: AuditLogger = Depends(get_audit_logger),
    client_request_id: Optional[str] = None
):
    internal_request_id = str(uuid.uuid4())
    start_time = time.monotonic()

    # Cache check (exclude volatile fields)
    cache_key = compute_cache_key(request.model_dump(exclude_defaults=True))
    cached = await redis.get(cache_key)
    if cached:
        REQUEST_COUNT.labels(status="200").inc()
        API_LATENCY_HIST.labels(endpoint="/infer").observe(time.monotonic() - start_time)
        return json.loads(cached)

    # Immutable audit
    audit_event = AuditEvent(
        request_id=internal_request_id,
        user_id=auth["user_id"],
        action="policy_inference",
        ip_address=await get_client_ip(Request),
        user_agent=request.headers.get("user-agent", ""),
        timestamp=time.time(),
        pii_hash=auth["pii_hash"]
    )
    await audit_logger.log_event(audit_event)

    payload = {
        "request_data": request.model_dump(),
        "request_id": internal_request_id,
        "client_request_id": client_request_id
    }

    try:
        result = await app.state.batch_processor.submit(payload)
        result['audit_hash'] = hashlib.sha256(json.dumps(result, sort_keys=True).encode()).hexdigest()[:16]
        await redis.setex(cache_key, get_settings().CACHE_TTL, json.dumps(result))
        API_LATENCY_HIST.labels(endpoint="/infer").observe(time.monotonic() - start_time)
        REQUEST_COUNT.labels(status="200").inc()
        return result
    except HTTPException:
        REQUEST_COUNT.labels(status="503").inc()
        raise
    except Exception as e:
        REQUEST_COUNT.labels(status="500").inc()
        logging.error(f"Inference failed [{client_request_id}]: {e}")
        raise HTTPException(status_code=500, detail="Internal inference error")

