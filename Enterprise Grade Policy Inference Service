class Settings(BaseSettings):
    JWT_PUBLIC_KEY: str  # Renamed to reflect RS256 usage
    REDIS_URL: str = "rediss://redis:6379/0?ssl_cert_reqs=none"
    KAFKA_BOOTSTRAP_SERVERS: List[str] = ["kafka:9092"]
    MODEL_INFERENCE_URL: str = "https://model-service:8001/batch"
    OTEL_EXPORTER_OTLP_ENDPOINT: str = "http://otel-collector:4317"

    # Performance
    MAX_BATCH_SIZE: int = 128
    BATCH_TIMEOUT: float = 0.1
    RATE_LIMIT_RPM: int = 1000
    CACHE_TTL: int = 1800
    API_TIMEOUT: float = 10.0

    class Config:
        env_file = ".env"
        case_sensitive = True

@lru_cache()
def get_settings() -> Settings:
    return Settings()

