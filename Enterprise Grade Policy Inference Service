API_LATENCY_HIST = Histogram("policy_service_api_latency_seconds", "API latency", ["endpoint"])
REQUEST_COUNT = Gauge("http_requests_total", "HTTP requests", ["status"])
WORKER_GAUGE = Gauge("batch_processor_active_workers", "Active workers")

# ===========================
# ENTERPRISE MODELS
# ===========================
class PolicyType(str, Enum):
    LIFE = "LIFE"
    HEALTH = "HEALTH"
    AUTO = "AUTO"

class PolicyRequest(BaseModel, extra="forbid"):
    user_id: str = Field(..., min_length=1, max_length=128, regex=r"^[a-zA-Z0-9_-]+$")
    age: int = Field(..., ge=18, le=120)
    policy_type: PolicyType
    features: Dict[str, float] = Field(default_factory=dict, max_items=100)

    @validator("features")
    def validate_features(cls, v):
        for k, val in v.items():
            if len(k) > 50 or not (0.0 <= val <= 1.0):
                raise ValueError("Invalid feature: key too long or value out of [0,1] range")
        return v

class PolicyResponse(BaseModel):
    decision: str
    risk_score: float
    explanation: str
    request_id: str
    audit_hash: str

class AuditEvent(BaseModel):
    request_id: str
    user_id: str
    action: str
    ip_address: str
    user_agent: str
    timestamp: float
    pii_hash: str

# ===========================
# ENTERPRISE SECURITY
# ===========================
security = HTTPBearer(auto_error=False)

async def get_client_ip(request: Request) -> str:
    """Extract real client IP respecting X-Forwarded-For headers for K8s/Istio"""
    xff = request.headers.get("x-forwarded-for")
    if xff:
        return xff.split(",")[0].strip()
    return request.client.host

async def verify_jwt_token(
    credentials: HTTPAuthorizationCredentials = Depends(security),
    request: Request = None
) -> Dict[str, Any]:
    """Zero-trust JWT + RBAC verification"""
    if not credentials:
        REQUEST_COUNT.labels(status="401").inc()
        raise HTTPException(status_code=401, detail="Missing authorization header")
    try:
        payload = jwt.decode(
            credentials.credentials,
            get_settings().JWT_PUBLIC_KEY,
            algorithms=["RS256"]
        )
        roles = payload.get("roles", [])
        if "policy_evaluator" not in roles:
            REQUEST_COUNT.labels(status="403").inc()
            raise HTTPException(status_code=403, detail="Insufficient permissions")

        client_ip = await get_client_ip(request)
        pii_hash = hashlib.sha256(f"{payload['sub']}{client_ip}".encode()).hexdigest()

        return {"user_id": payload["sub"], "roles": roles, "pii_hash": pii_hash}
    except JWTError:
        REQUEST_COUNT.labels(status="401").inc()
        raise HTTPException(status_code=401, detail="Invalid token")

# ===========================
# IMMUTABLE AUDIT LOGGING
# ===========================
class AuditLogger:
    def __init__(self):
        self.producer: Optional[AIOKafkaProducer] = None

    async def __aenter__(self):
        self.producer = AIOKafkaProducer(
            bootstrap_servers=get_settings().KAFKA_BOOTSTRAP_SERVERS,
            value_serializer=lambda v: json.dumps(v).encode('utf-8')
        )
        await self.producer.start()
        return self

    async def log_event(self, event: AuditEvent):
        if self.producer:
            await self.producer.send_and_wait("audit-events", event.dict())

    async def __aexit__(self, *args):
        if self.producer:
            await self.producer.stop()

async def get_audit_logger() -> AuditLogger:
    return app.state.audit_logger

# ===========================
# ENTERPRISE BATCH PROCESSOR
# ===========================
class EnterpriseBatchProcessor:
    def __init__(self):
        self.max_size = get_settings().MAX_BATCH_SIZE
        self.timeout = get_settings().BATCH_TIMEOUT
        self.queue: asyncio.Queue = asyncio.Queue(maxsize=1000)
        self.breaker = CircuitBreaker(
            failure_threshold=5,
            recovery_timeout=60,
            expected_exception=(httpx.HTTPStatusError, httpx.RequestError)
        )
        self.tasks: List[asyncio.Task] = []
        self.http_client = httpx.AsyncClient(
            timeout=5.0,
            cert=("client.crt", "client.key"),  # mTLS
            verify="ca.crt"
        )

    def start(self, workers: int = 4):
        for _ in range(workers):
            WORKER_GAUGE.inc()
            task = asyncio.create_task(self._batch_worker())
            self.tasks.append(task)

    async def stop(self):
        for task in self.tasks:
            task.cancel()
        await asyncio.gather(*self.tasks, return_exceptions=True)
        await self.http_client.aclose()
        WORKER_GAUGE.set(0)

    async def submit(self, payload: Dict[str, Any]) -> Dict[str, Any]:
        fut = asyncio.get_event_loop().create_future()
        await self.queue.put({"payload": payload, "future": fut})
        try:
            return await asyncio.wait_for(fut, timeout=get_settings().API_TIMEOUT)
        except asyncio.TimeoutError:
            REQUEST_COUNT.labels(status="503").inc()
            raise HTTPException(status_code=503, detail="Inference timeout")

    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=4, max=10))
    async def _call_model_circuit_breaker(self, payloads: List[Dict[str, Any]]):
        @self.breaker
        async def _protected_call():
            resp = await self.http_client.post(
                get_settings().MODEL_INFERENCE_URL,
                json=payloads,
                timeout=3.0
            )
            resp.raise_for_status()
            result = resp.json()
            if not isinstance(result, list):
                raise ValueError("Invalid model response format")
            return result
        return await _protected_call()

    async def _batch_worker(self):
        while True:
            batch_items = []
            try:
                item = await asyncio.wait_for(self.queue.get(), timeout=self.timeout)
                batch_items.append(item)
                while len(batch_items) < self.max_size:
                    try:
                        batch_items.append(self.queue.get_nowait())
                    except asyncio.QueueEmpty:
                        break
                batch_payloads = [i["payload"]["request_data"] for i in batch_items]
                try:
                    responses = await self._call_model_circuit_breaker(batch_payloads)
                except Exception as e:
                    responses = [{"decision": "ERROR", "risk_score": 0.0, "explanation": str(e)}] * len(batch_items)
                for i, resp in zip(batch_items, responses):
                    resp['request_id'] = i["payload"]["request_id"]
                    resp['audit_hash'] = hashlib.sha256(json.dumps(resp, sort_keys=True).encode()).hexdigest()[:16]
                    if not i["future"].done():
                        i["future"].set_result(resp)
                    self.queue.task_done()
            except Exception as e:
                for i in batch_items:
                    if not i["future"].done():
                        i["future"].set_exception(HTTPException(status_code=500, detail="Batch processing error"))
                    self.queue.task_done()
                logging.error(f"Batch worker error: {e}")

# ===========================
# CACHE & RATE LIMITING
# ===========================
async def get_redis():
    return await aioredis.from_url(get_settings().REDIS_URL, max_connections=50)

async def rate_limit_check(auth: Dict = Depends(verify_jwt_token), redis=Depends(get_redis)):
    key = f"rate:{auth['user_id']}:{int(time.time() // 60)}"
    count = await redis.incr(key)
    if count == 1:
        await redis.expire(key, 120)
    if count > get_settings().RATE_LIMIT_RPM:
        REQUEST_COUNT.labels(status="429").inc()
        raise HTTPException(status_code=429, detail="Rate limit exceeded")

def compute_cache_key(req: Dict) -> str:
    return hashlib.sha256(json.dumps(req, sort_keys=True).encode()).hexdigest()

# ===========================
# ENTERPRISE LIFESPAN
# ===========================
@asynccontextmanager
async def lifespan(app: FastAPI):
    # Startup
    app.state.redis = await get_redis()
    app.state.audit_logger = await AuditLogger().__aenter__()
    app.state.batch_processor = EnterpriseBatchProcessor()
    app.state.batch_processor.start(workers=4)

    # Observability
    provider = TracerProvider()
    processor = BatchSpanProcessor(OTLPSpanExporter(endpoint=get_settings().OTEL_EXPORTER_OTLP_ENDPOINT))
    provider.add_span_processor(processor)
    trace.set_tracer_provider(provider)

    yield

    # Shutdown
    await app.state.audit_logger.__aexit__(None, None, None)
    await app.state.batch_processor.stop()

# ===========================
# ENTERPRISE FASTAPI APP
# ===========================
app = FastAPI(title="Policy LLM Service Enterprise v6.1", version="6.1.0", lifespan=lifespan)

app.add_middleware(
    CORSMiddleware,
    allow_origins=["https://trusted.corp.com"],
    allow_credentials=True,
    allow_methods=["POST", "GET"],
    allow_headers=["*"],
)

@app.middleware("http")
async def security_headers(request: Request, call_next):
    response = await call_next(request)
    response.headers.update({
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "X-XSS-Protection": "1; mode=block",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "geolocation=(), microphone=(), camera=()"
    })
    return response

FastAPIInstrumentor.instrument_app(app)
Instrumentator().instrument(app).expose(app)

