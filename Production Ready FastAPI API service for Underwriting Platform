@app.post("/apply", response_model=IngestResponse)
@limiter.limit(f"{settings.RATE_LIMIT_PER_MINUTE}/minute")
async def apply_endpoint(
    request: Request,
    form_json: str = Field(..., alias="form_json"),
    documents: Optional[List[UploadFile]] = File(None),
    x_idempotency_key: Optional[str] = Header(None, alias="X-Idempotency-Key"),
    api_key_check: bool = Depends(verify_ingestion_api_key),
    bearer_principal: dict = Depends(verify_bearer_token)
):
    """Main ingestion endpoint:
    - Validates input form_json (JSON string)
    - Optional PDF uploads scanned and uploaded to S3
    - Calls local LLM for risk assessment
    - Encrypts PII (if configured) and enqueues a message to Redis stream
    """
    path = request.url.path
    start = time.time()
    try:
        # Rate limiting per client IP
        client_ip = request.client.host if request.client else "unknown"
        await redis_rate_check(client_ip, settings.RATE_LIMIT_PER_MINUTE)

        # Parse applicant
        try:
            applicant = ApplicantForm.parse_raw(form_json)
        except Exception as e:
            logger.warning("Invalid form JSON: %s", e)
            raise HTTPException(status_code=400, detail=f"Invalid form data: {e}")

        # Idempotency: if X-Idempotency-Key provided check Redis
        internal_id = str(uuid.uuid4())
        if x_idempotency_key:
            lock_key = f"idemp:{x_idempotency_key}"
            # attempt to set temporary lock to avoid duplicate processing
            got = await redis_client.set(lock_key, internal_id, nx=True, ex=settings.IDEMPOTENCY_TTL)
            if not got:
                existing = await redis_client.get(lock_key)
                MET_IDEMPOTENT.inc()
                logger.info("Idempotent request skipped (key=%s existing_id=%s)", x_idempotency_key, existing)
                return JSONResponse(status_code=409, content={"detail": "Duplicate request"})

        # Handle documents: scan and upload to S3 (async)
        file_records = []
        if documents:
            # limit number of files and size
            for f in documents[:5]:
                contents = await f.read()
                if len(contents) > settings.S3_MAX_FILE_SIZE:
                    raise HTTPException(status_code=413, detail=f"File {f.filename} too large")
                # run PDF check (fail closed)
                await check_pdf_malware(contents, f.filename)
                # upload to S3 in background (do not await here to reduce latency)
                s3_key = f"{internal_id}/{uuid.uuid4().hex}-{f.filename}"
                file_records.append({"filename": f.filename, "s3_key": s3_key, "size": len(contents)})
                # schedule upload in background
                asyncio.create_task(upload_to_s3(contents, s3_key, f.content_type if hasattr(f, "content_type") else "application/pdf"))

        # Build prompt for LLM
        prompt = (
            "Analyze this insurance applicant and return JSON with keys: risk_score (0.0-1.0), "
            "risk_category (low|medium|high), reasoning (brief, max 500 chars). Applicant data:\n"
            f"{applicant.json()}"
        )

        # LLM call
        try:
            MET_LLM_CALLS.labels(status="attempt").inc()
            llm_result = await call_local_llm(prompt)
            raw_text = llm_result.get("raw", "")
            # attempt to parse JSON out of raw_text defensively
            try:
                # Prefer safest JSON extraction; simple approach below
                parsed = json.loads(raw_text.strip())
            except Exception:
                # try to find first balanced JSON substring
                parsed = attempt_extract_json(raw_text)
            risk = RiskScoreResponse(
                internal_id=internal_id,
                risk_score=float(parsed.get("risk_score", 0.5)),
                risk_category=parsed.get("risk_category", "medium"),
                reasoning=parsed.get("reasoning", "")[:500],
                llm_model=settings.LOCAL_LLM_MODEL
            )
            await llm_circuit.record_success()
        except HTTPException:
            # propagate HTTPException directly
            raise
        except Exception as e:
            # LLM failed: fallback to rule-based and enqueue, still continue
            logger.exception("LLM failed, falling back to simple rule-based scoring: %s", e)
            risk = fallback_risk_assessment(applicant)
            await llm_circuit.record_failure()

        # Encrypt PII if configured
        applicant_bytes = applicant.json().encode()
        encrypted = None
        if fernet_cipher:
            try:
                encrypted = fernet_cipher.encrypt(applicant_bytes).decode()
            except Exception:
                logger.exception("Encryption failed")
                raise HTTPException(status_code=500, detail="Encryption failed")

        # Compose metadata to enqueue
        metadata = {
            "internal_id": internal_id,
            "application_hash": sha256_hash(applicant.json()),
            "form_encrypted": encrypted or applicant.json(),
            "files": json.dumps(file_records),
            "risk_assessment": risk.dict(),
            "received_at": datetime.utcnow().isoformat()
        }

        # Enqueue to Redis stream (with timeout)
        msg_id = await enqueue_to_redis_stream(metadata)

        # Finalize idempotency marker (so subsequent collisions get the processed id)
        if x_idempotency_key:
            await redis_client.set(f"idemp-final:{x_idempotency_key}", internal_id, ex=settings.IDEMPOTENCY_TTL)

        # Audit log (PII-safe)
        logger.info("AUDIT | enqueue | user=%s | app_id=%s | internal_id=%s | files=%d",
                    pii_safe(str(applicant.application_id)), pii_safe(getattr(request.client, "host", "unknown")), internal_id, len(file_records))

        # Success response
        elapsed = time.time() - start
        MET_REQS.labels(path=path, method="POST", status="200").inc()
        MET_LATENCY.labels(path=path).observe(elapsed)
        return IngestResponse(
            internal_id=internal_id,
            enqueued=True,
            message=f"Processed (Risk: {risk.risk_category})",
            timestamp=datetime.utcnow(timezone.utc).isoformat()
        )
    except RateLimitExceeded as rl:
        MET_REQS.labels(path=path, method="POST", status="429").inc()
        raise HTTPException(status_code=429, detail="Rate limit exceeded")
    except HTTPException as he:
        MET_REQS.labels(path=path, method="POST", status=str(he.status_code)).inc()
        raise
    except Exception as e:
        logger.exception("Unhandled error in /apply: %s", e)
        MET_REQS.labels(path=path, method="POST", status="500").inc()
        sentry_sdk.capture_exception(e)
        raise HTTPException(status_code=500, detail="Internal server error")

# -------------------------
# Background S3 upload helper
# -------------------------
async def upload_to_s3(content_bytes: bytes, key: str, content_type: str = "application/pdf"):
    """Uploads file bytes to S3 using aioboto3 in background; logs errors to audit and Sentry."""
    try:
        async with s3_session.client("s3", region_name=settings.S3_REGION) as s3:
            await s3.put_object(Bucket=settings.S3_BUCKET, Key=key, Body=content_bytes, ContentType=content_type)
            logger.info("S3 upload succeeded: %s", key)
    except Exception as e:
        logger.exception("S3 upload failed for %s: %s", key, e)
        sentry_sdk.capture_exception(e)
        # write minimal DLQ in Redis for operator action
        try:
            await redis_client.xadd("file_upload_dlq", {"key": key, "error": str(e)}, nomkstream=True)
        except Exception:
            pass

# -------------------------
# Utility: SHA256 hash
# -------------------------
import hashlib
def sha256_hash(payload: str) -> str:
    return hashlib.sha256(payload.encode()).hexdigest()

# -------------------------
# Defensive JSON extraction (balanced-brace)
# -------------------------
def attempt_extract_json(s: str) -> Dict[str, Any]:
    """Attempt to extract first balanced JSON object from a string."""
    if not s:
        return {}
    start = None
    depth = 0
    in_str = False
    esc = False
    for i, ch in enumerate(s):
        if ch == '"' and not esc:
            in_str = not in_str
        if in_str and ch == "\\" and not esc:
            esc = True
            continue
        else:
            esc = False
        if not in_str:
            if ch == '{':
                if start is None:
                    start = i
                depth += 1
            elif ch == '}':
                depth -= 1
                if start is not None and depth == 0:
                    try:
                        return json.loads(s[start:i+1])
                    except Exception:
                        return {}
    return {}

# -------------------------
# Fallback rule-based risk assessment
# -------------------------
def fallback_risk_assessment(applicant: ApplicantForm) -> RiskScoreResponse:
    score = 0.5
    if applicant.smoker:
        score += 0.25
    if applicant.bmi and applicant.bmi > 30:
        score += 0.2
    if applicant.age and (applicant.age < 21 or applicant.age > 70):
        score += 0.2
    score = min(1.0, score)
    if score < 0.4:
        cat = "low"
    elif score < 0.75:
        cat = "medium"
    else:
        cat = "high"
    return RiskScoreResponse(
        internal_id=str(uuid.uuid4()),
        risk_score=score,
        risk_category=cat,
        reasoning=f"Rule-based fallback (smoker={applicant.smoker}, bmi={applicant.bmi})",
        llm_model="fallback"
    )

