async def verify_ingestion_api_key(api_key: Optional[str] = Depends(api_key_header)):
    if not api_key or api_key != settings.INGESTION_API_KEY:
        logger.warning("Invalid API key attempt")
        raise HTTPException(status_code=403, detail="Invalid API key")
    return True

async def verify_bearer_token(creds: Optional[HTTPAuthorizationCredentials] = Depends(bearer)):
    # Minimal placeholder - integrate JWT decode with JOSE in production
    if not creds:
        raise HTTPException(status_code=401, detail="Missing bearer token")
    token = creds.credentials
    # For security, do not log raw token
    # Here, accept token if equals settings.JWT_SECRET for demo mode
    if settings.JWT_SECRET and token != settings.JWT_SECRET:
        raise HTTPException(status_code=401, detail="Invalid token")
    return {"sub": "service-principal"}

# Redis-backed leaky-bucket rate limiter (per IP)
async def redis_rate_check(client_id: str, limit_per_minute: int) -> None:
    key = f"rate:{client_id}"
    now_ts = int(time.time())
    # Using fixed-window counter with TTL ~70s for simplicity; sliding window or token-bucket recommended
    res = await redis_client.incr(key)
    if res == 1:
        await redis_client.expire(key, 70)
    if res > limit_per_minute:
        raise RateLimitExceeded(detail="Rate limit exceeded")

# -------------------------
# LLM client with circuit breaker and retries
# -------------------------
class CircuitBreaker:
    def __init__(self, threshold: int = 5, cooldown: int = 30):
        self.threshold = threshold
        self.cooldown = cooldown
        self.failures_key = "llm:circuit:failures"
        self.state_key = "llm:circuit:state"

    async def allowed(self) -> bool:
        state = await redis_client.get(self.state_key)
        if state == "open":
            # check expiry
            return False
        return True

    async def record_failure(self):
        failures = await redis_client.incr(self.failures_key)
        await redis_client.expire(self.failures_key, self.cooldown * 2)
        if failures >= self.threshold:
            await redis_client.set(self.state_key, "open", ex=self.cooldown)
            logger.warning("LLM circuit opened after %d failures", failures)

    async def record_success(self):
        await redis_client.delete(self.failures_key)
        await redis_client.delete(self.state_key)

llm_circuit = CircuitBreaker()

@retry(stop=stop_after_attempt(settings.LLM_RETRY_ATTEMPTS), wait=wait_exponential(multiplier=1, min=1, max=8),
       retry=retry_if_exception_type((httpx.RequestError, httpx.HTTPStatusError, asyncio.TimeoutError)))
async def call_local_llm(prompt: str) -> Dict[str, Any]:
    """Call the local OpenAI-compatible LLM endpoint and return JSON-parsed output."""
    if not await llm_circuit.allowed():
        MET_LLM_CALLS.labels(status="circuit_open").inc()
        raise HTTPException(status_code=503, detail="LLM circuit open")

    async with LLM_SEMAPHORE:
        payload = {
            "model": settings.LOCAL_LLM_MODEL,
            "messages": [{"role": "user", "content": prompt}],
            "temperature": 0.1
        }
        start = time.time()
        try:
            resp = await httpx_llm_client.post("/chat/completions", json=payload)
            resp.raise_for_status()
            MET_LLM_CALLS.labels(status="success").inc()
            MET_LLM_LATENCY.observe(time.time() - start)
            content = resp.json()
            # Defensive extraction: support both streaming and standard shapes
            choices = content.get("choices") or []
            if not choices:
                raise ValueError("LLM returned no choices")
            message = choices[0].get("message") or {}
            text = message.get("content") or ""
            # parse JSON embedded in text if needed
            return {"raw": text, "meta": content}
        except Exception as e:
            MET_LLM_CALLS.labels(status="error").inc()
            await llm_circuit.record_failure()
            logger.warning("LLM call failed: %s", e)
            raise

