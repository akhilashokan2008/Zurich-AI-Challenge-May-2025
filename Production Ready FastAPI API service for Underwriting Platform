@app.on_event("startup")
async def startup_event():
    global REDIS_POOL, redis_client, httpx_llm_client, s3_session, fernet_cipher
    # Metrics server
    asyncio.create_task(asyncio.to_thread(start_metrics_server))

    # Redis pool
    REDIS_POOL = redis.ConnectionPool.from_url(settings.REDIS_URL, max_connections=settings.REDIS_POOL_MAX)
    redis_client = redis.Redis(connection_pool=REDIS_POOL, decode_responses=True)

    # Test Redis connectivity (fail early)
    try:
        await redis_client.ping()
        logger.info("Connected to Redis")
    except Exception as e:
        logger.exception("Cannot connect to Redis: %s", e)
        raise

    # httpx client for LLM (single per-process)
    httpx_llm_client = httpx.AsyncClient(base_url=settings.LLM_API_BASE_URL, timeout=settings.LLM_TIMEOUT)

    # aioboto3 session for S3
    s3_session = aioboto3.Session()

    # Fernet cipher if provided
    if settings.ENCRYPTION_KEY_FOR_PII:
        try:
            fernet_cipher = Fernet(settings.ENCRYPTION_KEY_FOR_PII.encode())
        except Exception:
            logger.exception("Invalid Fernet key in settings")
            raise

    logger.info("Startup complete")

@app.on_event("shutdown")
async def shutdown_event():
    global redis_client, httpx_llm_client
    try:
        if httpx_llm_client:
            await httpx_llm_client.aclose()
    except Exception:
        pass
    try:
        if redis_client:
            await redis_client.close()
    except Exception:
        pass
    logger.info("Shutdown complete")

