@app.post("/apply", response_model=IngestResponse)
@limiter.limit(f"{settings.RATE_LIMIT_PER_MINUTE}/minute")
async def apply_endpoint(
    request: Request,
    applicant: ApplicantForm = Body(...),
    documents: Optional[List[UploadFile]] = File(None),
    x_idempotency_key: Optional[str] = Header(None, alias="X-Idempotency-Key"),
    background_tasks: BackgroundTasks,
    api_key_check: bool = Depends(verify_ingestion_api_key),
    bearer_principal: dict = Depends(verify_bearer_token)
):
    start = time.time()
    try:
        internal_id = str(uuid.uuid4())

        if x_idempotency_key:
            key = redis_key_prefix(f"idempotency:{x_idempotency_key}")
            existing = await redis_client.get(key)
            if existing:
                MET_IDEMPOTENT.inc()
                return IngestResponse(
                    internal_id=existing,
                    enqueued=True,
                    message="Already processed",
                    timestamp=datetime.now(timezone.utc).isoformat()
                )

        file_records = []
        if documents:
            for f in documents[:5]:
                contents = await f.read()
                if len(contents) > settings.S3_MAX_FILE_SIZE:
                    raise HTTPException(status_code=413, detail=f"File {f.filename} too large")
                await check_pdf_malware(contents, f.filename)
                s3_key = f"{internal_id}/{uuid.uuid4().hex}-{f.filename}"
                file_records.append({"filename": f.filename, "s3_key": s3_key, "size": len(contents)})
                background_tasks.add_task(upload_to_s3, contents, s3_key, f.content_type or "application/pdf")
                MET_S3_UPLOAD.labels(status="scheduled").inc()

        prompt = (
            "Analyze this insurance applicant and return JSON with keys: risk_score (0.0-1.0), "
            "risk_category (low|medium|high), reasoning (brief, max 500 chars). Applicant data:\n"
            f"{applicant.json()}"
        )

        try:
            llm_result = await call_local_llm(prompt)
            raw_text = llm_result.get("raw", "")
            try:
                parsed = json.loads(raw_text.strip())
            except Exception:
                parsed = attempt_extract_json(raw_text)
            llm_risk = LLMRisk(**parsed)
            risk = RiskScoreResponse(
                internal_id=internal_id,
                risk_score=llm_risk.risk_score,
                risk_category=llm_risk.risk_category,
                reasoning=llm_risk.reasoning,
                llm_model=settings.LOCAL_LLM_MODEL
            )
            await llm_circuit.record_success()
        except Exception as e:
            logger.exception("LLM failed, falling back: %s", e)
            risk = fallback_risk_assessment(internal_id, applicant)
            await llm_circuit.record_failure()

        applicant_bytes = applicant.json().encode()
        encrypted = None
        if fernet_cipher:
            encrypted = fernet_cipher.encrypt(applicant_bytes).decode()

        # Deterministic hash for data integrity
        applicant_json_sorted = applicant.json(sort_keys=True)
        metadata = {
            "internal_id": internal_id,
            "application_hash": sha256_hash(applicant_json_sorted),
            "form_encrypted": encrypted or applicant_json_sorted,
            "files": json.dumps(file_records),
            "risk_assessment": risk.dict(),
            "received_at": datetime.now(timezone.utc).isoformat()
        }

        await enqueue_to_redis_stream(metadata)

        if x_idempotency_key:
            await redis_client.set(key, internal_id, ex=settings.IDEMPOTENCY_TTL)

        logger.info("AUDIT | enqueue | user=%s | app_id=%s | internal_id=%s | files=%d",
                    pii_safe(str(applicant.application_id)), pii_safe(request.client.host if request.client else "unknown"), internal_id, len(file_records))

        MET_REQS.labels(method="POST", status="200").inc()
        MET_LATENCY.observe(time.time() - start)
        return IngestResponse(
            internal_id=internal_id,
            enqueued=True,
            message=f"Processed (Risk: {risk.risk_category})",
            timestamp=datetime.now(timezone.utc).isoformat()
        )
    except RateLimitExceeded:
        MET_REQS.labels(method="POST", status="429").inc()
        raise HTTPException(status_code=429, detail="Rate limit exceeded")
    except HTTPException:
        raise
    except Exception as e:
        logger.exception("Unhandled error: %s", e)
        MET_REQS.labels(method="POST", status="500").inc()
        sentry_sdk.capture_exception(e)
        raise HTTPException(status_code=500, detail="Internal server error")

# -------------------------
# Background S3 upload (with retry + metrics)
# -------------------------
@retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=1, max=4))
async def upload_to_s3(content_bytes: bytes, key: str, content_type: str = "application/pdf"):
    try:
        async with s3_session.client("s3", region_name=settings.S3_REGION) as s3:
            await s3.put_object(Bucket=settings.S3_BUCKET, Key=key, Body=content_bytes, ContentType=content_type)
        logger.info("S3 upload succeeded: %s", key)
        MET_S3_UPLOAD.labels(status="success").inc()
    except Exception as e:
        logger.exception("S3 upload failed (final): %s | %s", key, e)
        sentry_sdk.capture_exception(e)
        MET_S3_UPLOAD.labels(status="failed").inc()
        await redis_client.xadd(redis_key_prefix("file_upload_dlq"), {"key": key, "error": str(e)}, nomkstream=True)
        raise

