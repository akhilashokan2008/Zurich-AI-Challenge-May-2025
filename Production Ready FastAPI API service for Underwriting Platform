@app.get("/health/deps")
async def dependency_health():
    resp = {"redis": False, "llm": False, "s3": False}
    # Redis
    try:
        await redis_client.ping()
        resp["redis"] = True
    except Exception as e:
        logger.warning("Redis health check failed: %s", e)
    # LLM
    try:
        # call a lightweight LLM endpoint /healthz if available, otherwise ping base
        r = await httpx_llm_client.get("/health/ready")
        resp["llm"] = (r.status_code == 200)
    except Exception:
        resp["llm"] = False
    # S3
    try:
        async with s3_session.client("s3", region_name=settings.S3_REGION) as s3:
            await s3.head_bucket(Bucket=settings.S3_BUCKET)
            resp["s3"] = True
    except Exception as e:
        logger.warning("S3 health check failed: %s", e)
    return resp

