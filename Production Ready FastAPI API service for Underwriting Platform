# -------------------------
# Utilities
# -------------------------
def pii_safe(value: Optional[str]) -> str:
    if not value:
        return ""
    if len(value) <= 6:
        return "****"
    return value[:2] + "****" + value[-2:]

async def enqueue_to_redis_stream(payload: Dict[str, Any]) -> str:
    stream_key = redis_key_prefix("preprocessed_stream")
    msg_id = await redis_client.xadd(stream_key, payload, nomkstream=True)
    try:
        MET_QUEUE_LEN.set(await redis_client.xlen(stream_key))
    except Exception:
        pass
    return msg_id.decode() if isinstance(msg_id, bytes) else str(msg_id)

def has_javascript(doc: fitz.Document) -> bool:
    for xref in range(1, doc.xref_length()):
        js = doc.xref_get_key(xref, "JS")
        if js[0] != "null":
            return True
    return False

async def check_pdf_malware(file_bytes: bytes, filename: str) -> None:
    if not fitz:
        return
    try:
        doc = fitz.open(stream=file_bytes, filetype="pdf")
        suspicious = doc.needs_pass or doc.embfile_count() > 0 or has_javascript(doc)
        if suspicious:
            raise HTTPException(status_code=415, detail=f"Malicious PDF content detected in {filename}")
        doc.close()
    except Exception as e:
        logger.warning("PDF validation failed for %s: %s", filename, e)
        raise HTTPException(status_code=415, detail=f"PDF validation failed for {filename}: {e}")

