def redis_key_prefix(key: str) -> str:
    return f"{settings.APP_NAME}:{settings.ENV}:{key}"

@asynccontextmanager
async def lifespan(app: FastAPI):
    global redis_client, httpx_llm_client, s3_session, fernet_cipher

    # Startup
    asyncio.create_task(asyncio.to_thread(start_metrics_server))

    redis_client = redis.from_url(settings.REDIS_URL, decode_responses=True)
    try:
        await redis_client.ping()
        logger.info("Connected to Redis")
    except Exception as e:
        logger.exception("Cannot connect to Redis: %s", e)
        raise

    httpx_llm_client = httpx.AsyncClient(base_url=settings.LLM_API_BASE_URL, timeout=settings.LLM_TIMEOUT)
    s3_session = aioboto3.Session()

    if settings.ENCRYPTION_KEY_FOR_PII:
        try:
            fernet_cipher = Fernet(settings.ENCRYPTION_KEY_FOR_PII.encode())
        except Exception:
            logger.exception("Invalid Fernet key")
            raise

    logger.info("Application startup complete")
    yield

    # Shutdown
    if httpx_llm_client:
        await httpx_llm_client.aclose()
    if redis_client:
        await redis_client.close()
    logger.info("Application shutdown complete")

app = FastAPI(title=settings.APP_NAME, lifespan=lifespan, max_body_size=settings.S3_MAX_FILE_SIZE * 10)

