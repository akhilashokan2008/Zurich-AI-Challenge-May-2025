def pii_safe(value: Optional[str]) -> str:
    """Return a redacted-similar short representation for audit logs."""
    if not value:
        return ""
    if len(value) <= 6:
        return "****"
    return value[:2] + "****" + value[-2:]

async def enqueue_to_redis_stream(payload: Dict[str, Any]) -> str:
    """Enqueue ingestion metadata to Redis stream (atomic)."""
    try:
        stream_key = "preprocessed_stream"
        msg_id = await redis_client.xadd(stream_key, payload, nomkstream=True)
        # update gauge
        try:
            MET_QUEUE_LEN.set(await redis_client.xlen(stream_key))
        except Exception:
            pass
        return msg_id.decode() if isinstance(msg_id, bytes) else str(msg_id)
    except Exception as e:
        logger.exception("Failed to enqueue to Redis stream: %s", e)
        raise

async def check_pdf_malware(file_bytes: bytes, filename: str) -> None:
    """Lightweight PDF checks using PyMuPDF when available. Fails closed for suspicious files."""
    if not fitz:
        # If lib missing, skip heavy checks but enforce size limits
        return
    try:
        doc = fitz.open(stream=file_bytes, filetype="pdf")
        suspicious = False
        # Check for JavaScript / embedded files / annotations
        if getattr(doc, "needs_pass", False) or getattr(doc, "embedded_file_count", lambda: 0)() > 0:
            suspicious = True
        for page_num in range(len(doc)):
            page = doc[page_num]
            # Check for JS in page (get_js may or may not be present)
            js = getattr(page, "get_js", lambda: None)()
            if js:
                suspicious = True
                break
        doc.close()
        if suspicious:
            raise HTTPException(status_code=415, detail=f"Malicious PDF content detected in {filename}")
    except Exception as e:
        logger.warning("PDF validation failed for %s: %s", filename, e)
        raise HTTPException(status_code=415, detail=f"PDF validation failed for {filename}: {e}")

